{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Toolkit catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "version": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "path",
          "category",
          "technologies",
          "projectTypes",
          "compatibility",
          "dependencies",
          "source",
          "license",
          "revision",
          "validation",
          "files",
          "fileHashes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^library/(skills|community|local)/"
          },
          "category": {
            "type": "string"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "projectTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "compatibility": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object",
            "required": [
              "kind",
              "attribution"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "original",
                  "imported",
                  "local-import"
                ]
              },
              "attribution": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "upstreamRevision": {
                "type": "string"
              },
              "licenseEvidence": {
                "type": "string"
              },
              "localChanges": {
                "type": "string"
              }
            }
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "object",
            "required": [
              "status",
              "executableReview",
              "compatibility"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reviewed",
                  "screened"
                ]
              },
              "executableReview": {
                "enum": [
                  "reviewed",
                  "no-executables",
                  "pending"
                ]
              },
              "compatibility": {
                "type": "string"
              }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "fileHashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
